[Unit]
Description=October Bus hosted MCP gateway
Requires=october-bus.service
After=october-bus.service network.target
PartOf=october-bus.service

[Service]
Type=simple
User=october-bus
Group=october-bus
Environment=OCTOBER_BUS_DATA_DIR=/var/lib/october-bus
Environment=OCTOBER_BUS_RUNTIME_DIR=/run/october-bus
ExecStart=/usr/local/bin/october-bus gateway start --config /var/lib/october-bus/gateway.json --listen 127.0.0.1:8787
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
